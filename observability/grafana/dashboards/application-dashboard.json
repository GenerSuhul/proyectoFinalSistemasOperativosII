{
  "uid": "airport-app",
  "title": "Airport Application Dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Backend Up",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "up{job=\"airport-backend\"}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 6},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri, method, status)", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "JVM Memory Used",
      "gridPos": {"x": 15, "y": 0, "w": 9, "h": 6},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{job=\"airport-backend\"}) by (area)", "refId": "A"}]
    }
  ]
}
